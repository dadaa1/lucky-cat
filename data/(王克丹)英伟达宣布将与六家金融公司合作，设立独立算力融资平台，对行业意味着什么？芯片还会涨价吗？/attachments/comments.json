99","night_color":"#999999","has_border":false}],"child_comment_count":0,"child_comment_next_offset":null,"child_comments":[],"is_visible_only_to_myself":false,"_":null,"level_tag":2,"is_gift":false,"disclaimer_info":null,"markdown":"存储在涨，英伟达没必要放过赚钱的机会"},{"id":"11551847532","type":"comment","resource_type":"answer","member_id":27502283122,"url":"https://www.zhihu.com/api/v4/comment_v5/comments/11551847532","hot":false,"top":false,"content":"我觉得拿类似国内互联网泡沫和房地产经纪是不恰当的。<br>首先国内互联网泡沫没有实际支撑，而英伟达他们有，不仅有，还是大把的实体资产。此外因为一些原因，国内互联网是抛弃了最开始的“田园理念”，转向了实质性的垄断攫取暴利、机制压榨方向。这和国外互联网有很大差距。<br>其次。房地产经济无以为继是因为居民部门收入断崖下跌无法承担、而严重依靠土地财政的群体毫无底线。与之相比，外面居民部门收入是明显上涨的，哪怕是物价上涨的情况下、通胀压力之下，居民部门的压力比这里明显小太多。最典型的就是鲍威尔有一次发言中明确了这点。这还没考虑到ubi、四天工作制等已经成为共识的前提下。","score":0,"comment_type":0,"created_time":1786494408,"is_delete":false,"collapsed":false,"reviewing":false,"reply_comment_id":"0","reply_root_comment_id":"11551847532","liked":false,"like_count":0,"disliked":false,"dislike_count":0,"is_author":false,"can_like":true,"can_dislike":true,"can_delete":false,"can_reply":true,"can_hot":false,"can_author_top":false,"is_author_top":false,"can_collapse":false,"can_share":true,"can_unfold":false,"can_truncate":false,"can_more":true,"author":{"id":"caef88e54223cf8d33ef7ba26645b7a7","url_token":"zhisft5g4ac","name":"zhisFt5g4AC","avatar_url":"https://picx.zhimg.com/v2-1abe7b115ea0ab9e5dfe334d5a1fef38_l.jpg?source=06d4cd63","avatar_url_template":"https://pic1.zhimg.com/v2-1abe7b115ea0ab9e5dfe334d5a1fef38_l.jpg?source=06d4cd63","is_org":false,"type":"people","url":"https://www.zhihu.com/api/v4/comment_v5/people/caef88e54223cf8d33ef7ba26645b7a7","user_type":"people","headline":"","gender":0,"is_advertiser":false,"badge_v2":{"title":"","merged_badges":null,"detail_badges":null},"exposed_medal":{"medal_id":"","medal_name":"","avatar_url":"","description":"","medal_avatar_frame":"","can_click":false},"vip_info":{"is_vip":false,"target_url":null},"kvip_info":{"is_vip":false,"target_url":null},"level_info":null,"is_anon